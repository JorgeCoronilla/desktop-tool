# Configuración de Firma Digital para Windows
# Copia este archivo como .env.signing y configura tus certificados

# =============================================================================
# CERTIFICADO COMERCIAL (EV/OV)
# =============================================================================

# Ruta al archivo de certificado (.p12 o .pfx)
WIN_CSC_LINK=./certificates/mi-certificado.p12

# Contraseña del certificado
WIN_CSC_KEY_PASSWORD=mi-contraseña-secreta

# URL del servidor de timestamp (opcional)
WIN_TIMESTAMP_URL=http://timestamp.digicert.com

# =============================================================================
# INFORMACIÓN ADICIONAL
# =============================================================================

# URL de tu sitio web (aparece en las propiedades del archivo)
COMPANY_URL=https://mi-empresa.com

# Nombre de la empresa
COMPANY_NAME=Mi Empresa SL

# =============================================================================
# INSTRUCCIONES
# =============================================================================

# 1. Obtén un certificado de firma de código de:
#    - DigiCert (EV recomendado): https://www.digicert.com/code-signing/
#    - Sectigo: https://sectigo.com/ssl-certificates-tls/code-signing
#    - GlobalSign: https://www.globalsign.com/code-signing-certificate

# 2. Descarga el certificado en formato .p12 o .pfx

# 3. Colócalo en la carpeta ./certificates/

# 4. Configura las variables arriba con la ruta y contraseña correctas

# 5. Ejecuta: npm run build:win

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================

# - Los certificados EV eliminan las advertencias de SmartScreen inmediatamente
# - Los certificados OV necesitan tiempo para construir reputación
# - NUNCA subas este archivo con contraseñas reales a Git
# - Mantén el certificado y contraseña seguros